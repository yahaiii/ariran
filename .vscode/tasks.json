{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-lc", "cd /home/hp/projects/ariran && make install"],
      "group": "build"
    },
    {
      "label": "Start DB Stack",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-lc", "cd /home/hp/projects/ariran && make dev-up"]
    },
    {
      "label": "Initialize Database",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-lc", "cd /home/hp/projects/ariran && make init-db"],
      "dependsOn": [
        "Start DB Stack"
      ]
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-lc", "cd /home/hp/projects/ariran && make test-unit"],
      "group": "test"
    },
    {
      "label": "Run Lint + Type Check",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-lc", "cd /home/hp/projects/ariran && make check"],
      "group": "test"
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-lc", "cd /home/hp/projects/ariran && make run-api"],
      "group": "build"
    }
  ]
}
