{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "make install",
      "group": "build"
    },
    {
      "label": "Start DB Stack",
      "type": "shell",
      "command": "make dev-up"
    },
    {
      "label": "Initialize Database",
      "type": "shell",
      "command": "make init-db",
      "dependsOn": [
        "Start DB Stack"
      ]
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "make test-unit",
      "group": "test"
    },
    {
      "label": "Run Lint + Type Check",
      "type": "shell",
      "command": "make check",
      "group": "test"
    }
  ]
}
