# PostgreSQL / PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ariran
DB_USER=ariran_pipeline
DB_PASSWORD=changeme

# ACLED API
ACLED_API_KEY=your_acled_key_here
ACLED_EMAIL=your_email_here
ACLED_PASSWORD=your_password_here

# Twitter API
TWITTER_API_KEY=your_twitter_bearer_token_here

# News scraping
USER_AGENT="ariran-Bot/1.0 (Nigeria Open Crime Database; contact@ariran.ng)"

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost/airflow

# Logging
LOG_LEVEL=INFO
